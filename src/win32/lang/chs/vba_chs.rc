// The version of the English resource script this translation was generated
// from.  The executable carries the same hash and refuses to load a module
// whose value differs: such a module was made for another revision of the
// resources and may be missing strings, controls or whole dialogs.  An
// unchanged vba.rc keeps the value, so the version changes only when the
// English resources do.
#define VBA_L10N_VERSION "c498df09929043d684cc0d8cfc42798c9fcb35e1d77b45656bdacc6fb2994d13"

// The About box shows the application icon; its dialog template lives here,
// so the icon has to be here too or the control comes up empty.
