        MENUITEM "打开(&O)...\tCtrl+O",            RAMMENU_FILE_OPEN
        MENUITEM "保存(&S)\tCtrl+S",               RAMMENU_FILE_SAVE
        MENUITEM "另存为(&V)...\tCtrl+Shift+S",   RAMMENU_FILE_SAVEAS
        MENUITEM "追加文件(&A)...",             RAMMENU_FILE_APPEND
        MENUITEM "最近(&R)",                     RAMMENU_FILE_RECENT
        MENUITEM SEPARATOR
        MENUITEM "自动读取(&L)",                  RAMMENU_FILE_AUTOLOAD
        MENUITEM "保存窗口位置(&W)",       RAMMENU_FILE_SAVEWINDOW
        MENUITEM SEPARATOR
        MENUITEM "关闭(&C)\tAlt+F4",              IDCANCEL
    END
    POPUP "监视项(&W)"
    BEGIN
        MENUITEM "新建监视项(&N)\tN",               IDC_C_WATCH
        MENUITEM "编辑监视项(&E)\tE",              IDC_C_WATCH_EDIT
        MENUITEM "删除监视项(&R)\tR",            IDC_C_WATCH_REMOVE
        MENUITEM "复制监视项(&A)\tA",         IDC_C_WATCH_DUPLICATE
        MENUITEM SEPARATOR
        MENUITEM "上移(&U)\tU",                 IDC_C_WATCH_UP
        MENUITEM "下移(&D)\tD",               IDC_C_WATCH_DOWN
    END
END

LUAWINDOW_MENU MENU
BEGIN
    POPUP "控制台"
    BEGIN
        MENUITEM "字体(&F)...",                    IDC_LUACONSOLE_CHOOSEFONT
        MENUITEM "清除",                       IDC_LUACONSOLE_CLEAR
    END
    MENUITEM "关于(&A)",                          IDC_LUACONSOLE_ABOUT
END

