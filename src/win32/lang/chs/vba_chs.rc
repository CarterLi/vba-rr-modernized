IDR_MENU MENU
BEGIN
    POPUP "文件(&F)"
    BEGIN
        MENUITEM "打开 GBA R&OM...",            ID_FILE_OPEN
        MENUITEM "打开 &GBx ROM...",            ID_FILE_OPENGAMEBOY
        POPUP "最近的 ROM(&N)"
        BEGIN
            MENUITEM "清除(&C)",                      ID_FILE_RECENT_RESET
            MENUITEM "锁定(&L)",                       ID_FILE_RECENT_FREEZE
            MENUITEM SEPARATOR
            MENUITEM "打开最近的 ROM #&1",         ID_FILE_MRU_FILE1
            MENUITEM "打开最近的 ROM #&2",         ID_FILE_MRU_FILE2
            MENUITEM "打开最近的 ROM #&3",         ID_FILE_MRU_FILE3
            MENUITEM "打开最近的 ROM #&4",         ID_FILE_MRU_FILE4
            MENUITEM "打开最近的 ROM #&5",         ID_FILE_MRU_FILE5
            MENUITEM "打开最近的 ROM #&6",         ID_FILE_MRU_FILE6
            MENUITEM "打开最近的 ROM #&7",         ID_FILE_MRU_FILE7
            MENUITEM "打开最近的 ROM #&8",         ID_FILE_MRU_FILE8
            MENUITEM "打开最近的 ROM #&9",         ID_FILE_MRU_FILE9
            MENUITEM "打开最近的 ROM #1&0",        ID_FILE_MRU_FILE10
        END
        MENUITEM SEPARATOR
        POPUP "读取游戏(&L)"
        BEGIN
            MENUITEM "当前存档位(&C)",               ID_FILE_LOADGAME_CURRENT
            MENUITEM "最近的存档位(&R)",           ID_FILE_LOADGAME_MOSTRECENT
            MENUITEM "从文件读取(&F)...",          ID_FILE_LOAD
            MENUITEM SEPARATOR
            MENUITEM "导入电池存档(&B)...",     ID_FILE_IMPORT_BATTERYFILE
            MENUITEM "导入 &GameShark 快照...", ID_FILE_IMPORT_GAMESHARKSNAPSHOT
            MENUITEM SEPARATOR
            MENUITEM "存档位 #&1",                    ID_FILE_LOADGAME_SLOT1
            MENUITEM "存档位 #&2",                    ID_FILE_LOADGAME_SLOT2
            MENUITEM "存档位 #&3",                    ID_FILE_LOADGAME_SLOT3
            MENUITEM "存档位 #&4",                    ID_FILE_LOADGAME_SLOT4
            MENUITEM "存档位 #&5",                    ID_FILE_LOADGAME_SLOT5
            MENUITEM "存档位 #&6",                    ID_FILE_LOADGAME_SLOT6
            MENUITEM "存档位 #&7",                    ID_FILE_LOADGAME_SLOT7
            MENUITEM "存档位 #&8",                    ID_FILE_LOADGAME_SLOT8
            MENUITEM "存档位 #&9",                    ID_FILE_LOADGAME_SLOT9
            MENUITEM "存档位 #1&0",                   ID_FILE_LOADGAME_SLOT10
            MENUITEM SEPARATOR
            MENUITEM "读取后设为“当前”存档位(&M)",     ID_FILE_LOADGAME_MAKECURRENT
            MENUITEM "读取后设为“最近”存档位(&L)",      ID_FILE_LOADGAME_MAKERECENT
            MENUITEM SEPARATOR
            MENUITEM "启动时自动读取最近的存档位(&A)", ID_FILE_LOADGAME_AUTOLOADMOSTRECENT
        END
        POPUP "保存游戏(&S)"
        BEGIN
            MENUITEM "当前存档位(&C)",               ID_FILE_SAVEGAME_CURRENT
            MENUITEM "最早的存档位(&O)",                ID_FILE_SAVEGAME_OLDESTSLOT
            MENUITEM "保存到文件(&F)...",            ID_FILE_SAVE
            MENUITEM SEPARATOR
            MENUITEM "导出电池存档(&B)...",     ID_FILE_EXPORT_BATTERYFILE
            MENUITEM "导出 &GameShark 快照...", ID_FILE_EXPORT_GAMESHARKSNAPSHOT
            MENUITEM SEPARATOR
            MENUITEM "存档位 #&1",                    ID_FILE_SAVEGAME_SLOT1
            MENUITEM "存档位 #&2",                    ID_FILE_SAVEGAME_SLOT2
            MENUITEM "存档位 #&3",                    ID_FILE_SAVEGAME_SLOT3
            MENUITEM "存档位 #&4",                    ID_FILE_SAVEGAME_SLOT4
            MENUITEM "存档位 #&5",                    ID_FILE_SAVEGAME_SLOT5
            MENUITEM "存档位 #&6",                    ID_FILE_SAVEGAME_SLOT6
            MENUITEM "存档位 #&7",                    ID_FILE_SAVEGAME_SLOT7
            MENUITEM "存档位 #&8",                    ID_FILE_SAVEGAME_SLOT8
            MENUITEM "存档位 #&9",                    ID_FILE_SAVEGAME_SLOT9
            MENUITEM "存档位 #1&0",                   ID_FILE_SAVEGAME_SLOT10
            MENUITEM SEPARATOR
            MENUITEM "保存后设为“当前”存档位(&M)",     ID_FILE_SAVEGAME_MAKECURRENT
        END
        POPUP "当前存档位(&U)"
        BEGIN
            MENUITEM "切换到下一个存档位(&I)",      ID_FILE_SAVEGAME_INCREMENTSLOT
            MENUITEM "切换到上一个存档位(&D)",      ID_FILE_SAVEGAME_DECREMENTSLOT
            MENUITEM SEPARATOR
            MENUITEM "存档位 #&1",                    ID_SELECT_SLOT1
            MENUITEM "存档位 #&2",                    ID_SELECT_SLOT2
            MENUITEM "存档位 #&3",                    ID_SELECT_SLOT3
            MENUITEM "存档位 #&4",                    ID_SELECT_SLOT4
            MENUITEM "存档位 #&5",                    ID_SELECT_SLOT5
            MENUITEM "存档位 #&6",                    ID_SELECT_SLOT6
            MENUITEM "存档位 #&7",                    ID_SELECT_SLOT7
            MENUITEM "存档位 #&8",                    ID_SELECT_SLOT8
            MENUITEM "存档位 #&9",                    ID_SELECT_SLOT9
            MENUITEM "存档位 #1&0",                   ID_SELECT_SLOT10
            MENUITEM SEPARATOR
            MENUITEM "显示时间戳(&T)",            ID_FILE_SLOT_DISPLAYMODIFICATIONTIME
        END
        MENUITEM SEPARATOR
        MENUITEM "暂停(&P)",                      ID_FILE_PAUSE
        MENUITEM "单帧前进(&F)",              ID_DEBUG_NEXTFRAME
        MENUITEM "    计入延迟(&A)",        ID_DEBUG_NEXTFRAME_ACCOUNTFORLAG
        MENUITEM "回退(&W)",                     ID_TOOLS_REWIND
        MENUITEM "回退设置(&T)...",         ID_OPTIONS_EMULATOR_REWINDINTERVAL
        MENUITEM SEPARATOR
        MENUITEM "重置(&R)",                      ID_FILE_RESET
        MENUITEM "关闭(&C)",                      ID_FILE_CLOSE
        MENUITEM SEPARATOR
        MENUITEM "ROM 信息(&I)...",         ID_FILE_ROMINFORMATION
        MENUITEM SEPARATOR
        MENUITEM "退出(&X)",                       ID_FILE_EXIT
    END
    POPUP "选项(&O)"
    BEGIN
        POPUP "输入(&I)"
        BEGIN
            POPUP "配置控制器(&C)"
            BEGIN
                MENUITEM "控制器 &1...",            ID_OPTIONS_JOYPAD_CONFIGURE_1
                MENUITEM "控制器 &2...",            ID_OPTIONS_JOYPAD_CONFIGURE_2
                MENUITEM "控制器 &3...",            ID_OPTIONS_JOYPAD_CONFIGURE_3
                MENUITEM "控制器 &4...",            ID_OPTIONS_JOYPAD_CONFIGURE_4
                MENUITEM SEPARATOR
                MENUITEM "动作感应器(&M)...",           ID_OPTIONS_JOYPAD_MOTIONCONFIGURE
            END
            POPUP "使用控制器(&U)"
            BEGIN
                MENUITEM "控制器 &1",               ID_OPTIONS_JOYPAD_DEFAULTJOYPAD_1
                MENUITEM "控制器 &2",               ID_OPTIONS_JOYPAD_DEFAULTJOYPAD_2
                MENUITEM "控制器 &3",               ID_OPTIONS_JOYPAD_DEFAULTJOYPAD_3
                MENUITEM "控制器 &4",               ID_OPTIONS_JOYPAD_DEFAULTJOYPAD_4
            END
            MENUITEM SEPARATOR
            MENUITEM "允许 左+右 / 上+下(&A)", ID_OPTIONS_JOYPAD_ALLOWLEFTRIGHT
            MENUITEM SEPARATOR
            POPUP "连发(&F)"
            BEGIN
                MENUITEM "&A",                          ID_OPTIONS_JOYPAD_AUTOFIRE_A
                MENUITEM "&B",                          ID_OPTIONS_JOYPAD_AUTOFIRE_B
                MENUITEM "&L",                          ID_OPTIONS_JOYPAD_AUTOFIRE_L
                MENUITEM "&R",                          ID_OPTIONS_JOYPAD_AUTOFIRE_R
                MENUITEM "开始(&S)",                      ID_OPTIONS_JOYPAD_AUTOFIRE_START
                MENUITEM "选择(&T)",                     ID_OPTIONS_JOYPAD_AUTOFIRE_SELECT
                MENUITEM "上(&U)",                         ID_OPTIONS_JOYPAD_AUTOFIRE_UP
                MENUITEM "下(&D)",                       ID_OPTIONS_JOYPAD_AUTOFIRE_DOWN
                MENUITEM "左(&E)",                       ID_OPTIONS_JOYPAD_AUTOFIRE_LEFT
                MENUITEM "右(&I)",                      ID_OPTIONS_JOYPAD_AUTOFIRE_RIGHT
                MENUITEM SEPARATOR
                MENUITEM "全部清除(&C)",                  ID_OPTIONS_JOYPAD_AUTOFIRE_CLEAR
                MENUITEM "计入延迟(&F)",            ID_OPTIONS_JOYPAD_AUTOFIRE_ACCOUNTFORLAG
            END
            POPUP "连按(&H)"
            BEGIN
                MENUITEM "&A",                          ID_STICKY_A
                MENUITEM "&B",                          ID_STICKY_B
                MENUITEM "&L",                          ID_STICKY_L
                MENUITEM "&R",                          ID_STICKY_R
                MENUITEM "开始(&S)",                      ID_STICKY_START
                MENUITEM "选择(&T)",                     ID_STICKY_SELECT
                MENUITEM "上(&U)",                         ID_STICKY_UP
                MENUITEM "下(&D)",                       ID_STICKY_DOWN
                MENUITEM "左(&E)",                       ID_STICKY_LEFT
                MENUITEM "右(&I)",                      ID_STICKY_RIGHT
                MENUITEM SEPARATOR
                MENUITEM "全部清除(&C)",                  ID_STICKY_CLEAR
            END
            MENUITEM SEPARATOR
            MENUITEM "自定义所有命令(&Z)...",  ID_TOOLS_CUSTOMIZE
        END
        POPUP "速度(&S)"
        BEGIN
            POPUP "设置速度(&S)"
            BEGIN
                MENUITEM "6%（很慢）",              ID_OPTIONS_FRAMESKIP_THROTTLE_6
                MENUITEM "15%",                         ID_OPTIONS_FRAMESKIP_THROTTLE_15
                MENUITEM "25%",                         ID_OPTIONS_FRAMESKIP_THROTTLE_25
                MENUITEM "50%（半速）",            ID_OPTIONS_FRAMESKIP_THROTTLE_50
                MENUITEM "75%",                         ID_OPTIONS_FRAMESKIP_THROTTLE_75
                MENUITEM "100%（正常速度）",         ID_OPTIONS_FRAMESKIP_THROTTLE_100
                MENUITEM "150%",                        ID_OPTIONS_FRAMESKIP_THROTTLE_150
                MENUITEM "200%（双倍速度）",         ID_OPTIONS_FRAMESKIP_THROTTLE_200
                MENUITEM "300%",                        ID_OPTIONS_FRAMESKIP_THROTTLE_300
                MENUITEM "400%",                        ID_OPTIONS_FRAMESKIP_THROTTLE_400
                MENUITEM "600%（很快）",            ID_OPTIONS_FRAMESKIP_THROTTLE_600
                MENUITEM "其他(&O)...",                   ID_OPTIONS_FRAMESKIP_THROTTLE_OTHER
                MENUITEM SEPARATOR
                MENUITEM "加速(&I)",                   ID_OPTIONS_FRAMESKIP_THROTTLE_INCREASE
                MENUITEM "减速(&D)",                   ID_OPTIONS_FRAMESKIP_THROTTLE_DECREASE
            END
            POPUP "跳帧(&F)"
            BEGIN
                MENUITEM "跳过 &0 帧（不跳帧）", ID_OPTIONS_VIDEO_FRAMESKIP_0
                MENUITEM "跳过 &1 帧（每隔一帧）", ID_OPTIONS_VIDEO_FRAMESKIP_1
                MENUITEM "跳过 &2 帧（每 3 帧丢 2 帧）", ID_OPTIONS_VIDEO_FRAMESKIP_2
                MENUITEM "跳过 &3 帧",                     ID_OPTIONS_VIDEO_FRAMESKIP_3
                MENUITEM "跳过 &4 帧",                     ID_OPTIONS_VIDEO_FRAMESKIP_4
                MENUITEM "跳过 &5 帧",                     ID_OPTIONS_VIDEO_FRAMESKIP_5
                MENUITEM "跳过 &6 帧",                     ID_OPTIONS_VIDEO_FRAMESKIP_6
                MENUITEM "跳过 &7 帧",                     ID_OPTIONS_VIDEO_FRAMESKIP_7
                MENUITEM "跳过 &8 帧",                     ID_OPTIONS_VIDEO_FRAMESKIP_8
                MENUITEM "跳过 &9 帧（每 10 帧丢 9 帧）", ID_OPTIONS_VIDEO_FRAMESKIP_9
            END
            MENUITEM SEPARATOR
            MENUITEM "加速模式(&T)",                 ID_OPTIONS_EMULATOR_SPEEDUPTOGGLE
            MENUITEM SEPARATOR
            MENUITEM "同步模拟速度(&Y)", ID_OPTIONS_EMULATOR_SYNCHRONIZE
            MENUITEM "    精确声音音调(&P)",   ID_OPTIONS_FRAMESKIP_ACCURATEPITCH
            MENUITEM "    精确模拟速度(&E)", ID_OPTIONS_FRAMESKIP_ACCURATESPEED
        END
        MENUITEM SEPARATOR
        POPUP "视频(&V)"
        BEGIN
            POPUP "渲染方式(&R)"
            BEGIN
#if VBA_ENABLE_GDI
                MENUITEM "&GDI",                        ID_OPTIONS_VIDEO_RENDERMETHOD_GDI
                MENUITEM SEPARATOR
#endif
#if VBA_ENABLE_DDRAW
                MENUITEM "&DirectDraw",                 ID_OPTIONS_VIDEO_RENDERMETHOD_DIRECTDRAW
                MENUITEM "    仅用于模拟(&E)",   ID_OPTIONS_VIDEO_DDRAWEMULATIONONLY
                MENUITEM "    使用显存(&U)", ID_OPTIONS_VIDEO_DDRAWUSEVIDEOMEMORY
                MENUITEM SEPARATOR
#endif
                MENUITEM "Direct3D &11",                ID_OPTIONS_VIDEO_RENDERMETHOD_DIRECT3D11
                MENUITEM "Direct&3D 9Ex",               ID_OPTIONS_VIDEO_RENDERMETHOD_DIRECT3D
#if VBA_ENABLE_WGPU
                MENUITEM SEPARATOR
                MENUITEM "&WebGPU",                     ID_OPTIONS_VIDEO_RENDERMETHOD_WEBGPU
                POPUP "    We&bGPU 后端"
                BEGIN
                    MENUITEM "自动(&A)",              ID_OPTIONS_VIDEO_WGPUBACKEND_AUTO
                    MENUITEM SEPARATOR
                    MENUITEM "Direct3D &12",            ID_OPTIONS_VIDEO_WGPUBACKEND_D3D12
                    MENUITEM "&Vulkan",                 ID_OPTIONS_VIDEO_WGPUBACKEND_VULKAN
                    MENUITEM "&Metal",                  ID_OPTIONS_VIDEO_WGPUBACKEND_METAL
                    MENUITEM "&OpenGL (ANGLE)",         ID_OPTIONS_VIDEO_WGPUBACKEND_OPENGL
                END
#endif
#if VBA_ENABLE_OPENGL
                MENUITEM SEPARATOR
                MENUITEM "&OpenGL 3.3",                 ID_OPTIONS_VIDEO_RENDERMETHOD_OPENGL33
                MENUITEM "OpenG&L（旧版）",            ID_OPTIONS_VIDEO_RENDERMETHOD_OPENGL
                MENUITEM "    GL 三角形（旧版）(&R)", ID_OPTIONS_VIDEO_RENDEROPTIONS_GLTRIANGLE
                MENUITEM "    GL 四边形（旧版）(&Q)",    ID_OPTIONS_VIDEO_RENDEROPTIONS_GLQUADS
#endif
            END
            POPUP "纹理过滤(&T)"
            BEGIN
                MENUITEM "最近邻(&N)",                    ID_OPTIONS_VIDEO_TEXTUREFILTER_NEAREST
                MENUITEM "双线性(&B)",                   ID_OPTIONS_VIDEO_TEXTUREFILTER_BILINEAR
                MENUITEM "三线性(&L)",                  ID_OPTIONS_VIDEO_TEXTUREFILTER_TRILINEAR
            END
            MENUITEM SEPARATOR
// The label names the renderers that honour the setting, so it follows the
// ones this build has.
#if VBA_ENABLE_DDRAW && VBA_ENABLE_OPENGL && VBA_ENABLE_WGPU
            MENUITEM "垂直同步(&S)（DDraw、D3D11、OpenGL 3.3、WebGPU）", ID_OPTIONS_VIDEO_VSYNC
#elif VBA_ENABLE_DDRAW && VBA_ENABLE_OPENGL
            MENUITEM "垂直同步(&S)（DDraw、D3D11、OpenGL 3.3）", ID_OPTIONS_VIDEO_VSYNC
#elif VBA_ENABLE_DDRAW && VBA_ENABLE_WGPU
            MENUITEM "垂直同步(&S)（DDraw、D3D11、WebGPU）", ID_OPTIONS_VIDEO_VSYNC
#elif VBA_ENABLE_DDRAW
            MENUITEM "垂直同步(&S)（DDraw、D3D11）", ID_OPTIONS_VIDEO_VSYNC
#elif VBA_ENABLE_OPENGL && VBA_ENABLE_WGPU
            MENUITEM "垂直同步(&S)（D3D11、OpenGL 3.3、WebGPU）", ID_OPTIONS_VIDEO_VSYNC
#elif VBA_ENABLE_OPENGL
            MENUITEM "垂直同步(&S)（D3D11、OpenGL 3.3）", ID_OPTIONS_VIDEO_VSYNC
#elif VBA_ENABLE_WGPU
            MENUITEM "垂直同步(&S)（D3D11、WebGPU）", ID_OPTIONS_VIDEO_VSYNC
#else
            MENUITEM "垂直同步(&S)（D3D11）", ID_OPTIONS_VIDEO_VSYNC
#endif
            MENUITEM SEPARATOR
            POPUP "窗口尺寸(&W)"
            BEGIN
                MENUITEM "&1 倍",                     ID_OPTIONS_VIDEO_X1
                MENUITEM "&2 倍",                     ID_OPTIONS_VIDEO_X2
                MENUITEM "&3 倍",                     ID_OPTIONS_VIDEO_X3
                MENUITEM "&4 倍",                     ID_OPTIONS_VIDEO_X4
                MENUITEM "&5 倍",                     ID_OPTIONS_VIDEO_X5
                MENUITEM "&6 倍",                     ID_OPTIONS_VIDEO_X6
                MENUITEM "&7 倍",                     ID_OPTIONS_VIDEO_X7
                MENUITEM "&8 倍",                     ID_OPTIONS_VIDEO_X8
                MENUITEM "&9 倍",                     ID_OPTIONS_VIDEO_X9
                MENUITEM "1&0 倍",                    ID_OPTIONS_VIDEO_X10
                MENUITEM "1&1 倍",                    ID_OPTIONS_VIDEO_X11
                MENUITEM "1&2 倍",                    ID_OPTIONS_VIDEO_X12
            END
            MENUITEM SEPARATOR
            MENUITEM "全屏 (320x240)",       ID_OPTIONS_VIDEO_FULLSCREEN320X240
            MENUITEM "全屏 (640x480)",       ID_OPTIONS_VIDEO_FULLSCREEN640X480
            MENUITEM "全屏 (800x600)",       ID_OPTIONS_VIDEO_FULLSCREEN800X600
            MENUITEM "其他全屏尺寸(&O)...",       ID_OPTIONS_VIDEO_FULLSCREEN
            MENUITEM SEPARATOR
            MENUITEM "全屏最大缩放(&M)...",   ID_OPTIONS_VIDEO_FULLSCREENMAXSCALE
            POPUP "屏幕缩放(&S)"
            BEGIN
                MENUITEM "拉伸铺满(&S)",                 ID_OPTIONS_VIDEO_SCALING_STRETCH
                MENUITEM "保持纵横比(&A)",              ID_OPTIONS_VIDEO_SCALING_ASPECT
                MENUITEM "保持纵横比 + 整数缩放(&I)",   ID_OPTIONS_VIDEO_SCALING_INTEGER
            END
            MENUITEM "全屏隐藏菜单(&H)",      ID_FILE_TOGGLEMENU
            MENUITEM "全屏自动隐藏菜单(&A)", ID_OPTIONS_EMULATOR_AUTOHIDEMENU
            MENUITEM SEPARATOR
            MENUITEM "禁用 GBA 特效（混合、淡变、窗口）(&D)", ID_OPTIONS_VIDEO_DISABLESFX
            POPUP "图形图层(&L)"
            BEGIN
                MENUITEM "BG 0",                        ID_OPTIONS_VIDEO_LAYERS_BG0
                MENUITEM "BG 1",                        ID_OPTIONS_VIDEO_LAYERS_BG1
                MENUITEM "BG 2",                        ID_OPTIONS_VIDEO_LAYERS_BG2
                MENUITEM "BG 3",                        ID_OPTIONS_VIDEO_LAYERS_BG3
                MENUITEM "OBJ",                         ID_OPTIONS_VIDEO_LAYERS_OBJ
                MENUITEM "WIN 0",                       ID_OPTIONS_VIDEO_LAYERS_WIN0
